{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sql-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@bilims/mcp-sqlserver"
      ],
      "environment": {
        "SQLSERVER_HOST": "localhost",
        "SQLSERVER_PORT": "1433",
        "SQLSERVER_USER": "sa",
        "SQLSERVER_PASSWORD": "sql",
        "SQLSERVER_DATABASE": "Dev_Todo",
        "SQLSERVER_ENCRYPT": "true",
        "SQLSERVER_TRUST_CERT": "true"
      }
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Cursos\\MimoCode"
      ],
      "enabled": true,
    },
    "git": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "mcp_server_git",
        "--repository",
        "C:\\Cursos\\MimoCode"
      ],
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--browser",
        "chromium"
      ],
      "enabled": true,
    },
  },
}